# ============================================================
# Mono Core 4.0 - environment template
# Copy this file to .env and fill in your real values.
# ============================================================

# --- AI providers (at least one is required) ---
DEEPSEEK_API_KEY=sk-your_deepseek_key
OPENAI_API_KEY=sk-your_openai_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# --- Models ---
DEEPSEEK_MODEL=deepseek-chat
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
FAST_MODEL=gpt-4o-mini

# Which provider is used by default. Allowed: deepseek, openai, anthropic
AI_PROVIDER=deepseek

# --- Telegram bot ---
# Required for `python main.py bot`
BOT_TOKEN=123456:abcdef-your-telegram-bot-token
WEB_APP_URL=https://your-domain/

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Data ---
# Where mono_vault.db and logs live. Default: %APPDATA%/MonoCore on Windows,
# or ~/.mono on macOS / Linux. Leave empty to use the default.
MONO_DATA_DIR=

# --- Security ---
# AES-256-GCM passphrase used to encrypt values in the secrets table.
VAULT_PASSPHRASE=change-me-strong-passphrase

# --- Limits ---
RATE_LIMIT_PER_MIN=30
MAX_FILE_BYTES=52428800

# --- Founder's Access ---
FOUNDERS_LIMIT=50
FOUNDER_PRICE_USD=15

# --- Admin ---
# Your own Telegram uid, so /genkey works only for you.
ADMIN_UID=8725939105

# --- Mode ---
ENVIRONMENT=production

# ============================================================
# MonoGuard (content moderation via local Phi-3 Mini)
# ============================================================
# OpenAI-compatible chat endpoint. Use LM Studio, llama.cpp server or vLLM.
PHI3_BASE_URL=http://127.0.0.1:8080
PHI3_MODEL=phi3:mini
# Optional Redis cache URL. Leave empty to use the in-process LRU only.
PHI3_CACHE_REDIS_URL=

# ============================================================
# OAuth2 (Google)
# ============================================================
MONO_GOOGLE_CLIENT_ID=
MONO_GOOGLE_CLIENT_SECRET=
# Optional. Defaults to "<API_HOST>/api/auth/callback".
MONO_GOOGLE_REDIRECT_URI=
# Access token TTL in seconds (default 1800 = 30 minutes).
MONO_JWT_TTL=1800
